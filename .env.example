# Copia este fichero como .env.local y rellena los valores.
# .env.local está en .gitignore: la clave nunca debe llegar al repositorio.

# URL pública del sitio. Sin ella, el Open Graph y la canónica apuntan a localhost.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Formulario de contacto (https://resend.com — plan gratuito: 3.000 emails/mes).
# Sin esta clave el formulario no envía: avisa en pantalla y ofrece el correo
# directo, para que nunca se pierda un mensaje en silencio.
RESEND_API_KEY=

# Opcionales.
# A dónde llegan los mensajes (por defecto, el email del CV).
CONTACT_TO_EMAIL=
# Remitente. onboarding@resend.dev funciona sin verificar dominio, pero solo
# puede escribir a la dirección dueña de la cuenta de Resend. Para recibir en
# cualquier otra, verifica tu dominio en Resend y pon aquí algo como
# hola@tu-dominio.com.
CONTACT_FROM_EMAIL=
